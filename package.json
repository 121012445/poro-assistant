{
  "name": "poro-assistant",
  "version": "1.6.1",
  "description": "Poro - 英雄联盟游戏助手",
  "main": "main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:limited": "electron-builder --config electron-builder.limited.js",
    "prebuild:limited": "node check_build.js",
    "build:all": "npm run build && npm run build:limited",
    "test": "node tests/run-all.js",
    "test:e2e:readonly": "node test_chatsend.js",
    "test:e2e:chat": "node test_chatlive.js",
    "test:e2e:spectate": "node test_spectate_e2e.js",
    "test:all": "node tests/run-all.js"
  },
  "author": "Agnes",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.poro.assistant",
    "productName": "Poro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "app-icon.ico"
      },
      {
        "from": "renderer/assets/icon.png",
        "to": "app-icon.png"
      }
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "asar": true,
    "asarUnpack": [
      "main/native/PoroInput.exe",
      "main/native/PoroOcr.ps1",
      "main/native/PoroOcrWorker.ps1",
      "main/native/PoroChatOcrWorker.ps1",
      "main/native/PoroRapidOcrWorker.py",
      "node_modules/**/*.node"
    ]
  },
  "dependencies": {
    "koffi": "^3.3.1",
    "ws": "^8.21.3"
  }
}
