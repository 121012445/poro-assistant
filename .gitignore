# 二进制产物一律不入库。
# 唯一例外: 原生输入助手 PoroInput.exe —— 本环境没有可用的 C# 编译链
# (见 main/win-rect.js 的注释: csc.exe 被安全策略拦截, 当时改用 koffi 绕开),
# 它只能手动编译后随仓库分发。源码是同目录的 PoroInput.cs,
# 改动 .cs 后必须重新编译 .exe 并一起提交, 否则两者会静默漂移。
*.exe
!main/native/PoroInput.exe

# 调试脚手架: 临时产物与备份不入库, 只保留有长期价值的工具脚本
_debug_archive/*
!_debug_archive/analyze_sections.py
!_debug_archive/probe_renderer.js
!_debug_archive/split_renderer.py
# 以下三个是长期复用的工具: 打 asar / 校验 asar 内容 / 端到端读界面版本号
!_debug_archive/build_asar.js
!_debug_archive/verify_asar.js
!_debug_archive/probe_version_ui.js
!_debug_archive/probe_bench_live.js
# 一键闭环: 测试 -> 打包 -> 替换 -> 实测界面版本号
!_debug_archive/deploy.js
# 选人浮窗的端到端验证 (不依赖游戏: 直接推一帧, 看窗是否建出来/渲染/点击回传)
!_debug_archive/probe_overlay.js
# 用 koffi 枚举窗口, 找客户端窗口类名与矩形 (贴边定位的数据来源)
!_debug_archive/probe_client_window.js
